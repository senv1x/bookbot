# Copy to .env for local runs. NEVER commit .env. Empty value = feature off / mocked.

# Public URL of this deployment (used in demo/dashboard links and the embed snippet)
PUBLIC_BASE_URL=

# AI answers. Empty = rule-based answers from the scraped data (no AI cost, still works)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint (proxy / OpenRouter / Groq). Default https://api.openai.com/v1
OPENAI_BASE_URL=

# Email (booking alerts to owners, setup requests to us). Empty SMTP_HOST = emails are logged to data/outbox.jsonl
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=shipfastlabs.dev@gmail.com SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_DRY_RUN=
SETUP_REQUEST_TO=shipfastlabs.dev@gmail.com
# Optional: copy of every booking alert (e.g. to watch demo activity)
NOTIFY_BCC=

# Stripe Payment Links (create in Stripe dashboard -> Payment Links). Empty = buttons open the "Request setup" form
STRIPE_LINK_STARTER=
STRIPE_LINK_PRO=
STRIPE_LINK_SETUP=

# /admin?token=... overview of all assistants and setup requests (long random string)
ADMIN_TOKEN=
# Dashboard keys for the seeded demo assistants are HMAC(SEED_ADMIN_SECRET, slug). Empty = no dashboards for seeds
SEED_ADMIN_SECRET=

# Storage. Default data/bookbot.db (ephemeral on Render free: use a disk or accept resets; seeds reload on boot)
DATABASE_PATH=
PORT=8090
# Scraper tuning
SCRAPE_MAX_PAGES=8
SCRAPE_TIMEOUT=10
RATE_ONBOARD_PER_HOUR=20
RATE_CHAT_PER_MIN=40
